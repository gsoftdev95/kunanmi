\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af0 \ltrch\fcs0 \f3\fs20\kerning2\insrsid2770955\charrsid2770955 \loch\af3\dbch\af0\hich\f3 \'b7\tab}Gesti\'f3n de estados de los pedidos. 
